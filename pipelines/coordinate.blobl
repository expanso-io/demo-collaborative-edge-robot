# All coordination runs in this serial Edge processor.
let s = this.saved
let e = this.event
let now = timestamp_unix_milli()
let tick = $e.tick.or(false)
let card = $e.from.or("") == "camera-1"
let mic = $e.from.or("") == "mic-1"
let stop = $mic && $e.body.value.or("") == "stop"
let valid = $e.body.confidence.or(0) >= env("CONFIDENCE_THRESHOLD").number()
let unclear = !$tick && ($card || $mic) && (!$valid || $e.body.value == null)
let go = $mic && $valid && $e.body.value.or("") == "go"
let blocked = $now - $s.last_stop < 1500
let due = $tick && $s.pending > 0 && $now >= $s.pending && !$blocked
root.saved = $s
root.action = ""
root.emit = !$tick || $due
root.saved = if $stop {
  $s.assign({"phase":"paused", "reason":"stop wins", "pending":0, "last_stop":$now})
} else if $unclear {
  $s.assign({"phase":"uncertain", "reason":"below confidence threshold or unreadable input", "pending":0, "clear":false})
} else if $card && $valid {
  $s.assign({"destination":$e.body.value, "phase":"ready", "reason":"destination selected", "pending":0, "clear":true})
} else if $go && $blocked {
  $s.assign({"phase":"paused", "reason":"stop wins within 1.5 seconds", "pending":0})
} else if $go && $s.destination == null {
  $s.assign({"phase":"ready", "reason":"no destination yet", "pending":0})
} else if $go && !$s.clear {
  $s.assign({"phase":"uncertain", "reason":"waiting for a confident card", "pending":0})
} else if $go {
  $s.assign({"reason":"checking stop window", "pending":if $s.pending > 0 { $s.pending } else { $now + 1500 }})
} else if $due {
  $s.assign({"phase":"moving", "reason":"go accepted", "pending":0})
} else { $s }
root.action = if $stop || ($go && $blocked) { "pause" } else if $unclear || ($card && $valid) { "hold" } else if $due { "move_to" } else { "" }
